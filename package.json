{
  "name": "evaqueue",
  "version": "0.0.0-development",
  "description": "EvaQueue.js provide a unified API across different high performance queue backends, including Kafka, AliMNS",
  "main": "index.js",
  "scripts": {
    "prestart": "npm run build",
    "prepublish": "npm run build",
    "ava": "LOG_LEVEL=error NODE_ENV=test ava --verbose --serial",
    "test": "nyc -a --reporter=lcov --reporter=text --reporter=html npm run ava",
    "lint": "tslint src/**/*.ts --exclude '**/*.d.ts' --project tsconfig.json",
    "build": "rm -rf lib && tsc -m \"System\" --outFile \"lib/index\" --sourceMap \"false\" && rm lib/index && mv lib/index.d.ts ./ && tsc",
    "install:peers": "npm install --no-save $(jq -r '.peerDependencies | to_entries | map(\"\\(.key)@\\(.value | tostring)\") | join(\" \")' package.json)",
    "install:peers:mac": "CPPFLAGS=-I/usr/local/opt/openssl/include LDFLAGS=-L/usr/local/opt/openssl/lib npm install --no-save $(jq -r '.peerDependencies | to_entries | map(\"\\(.key)@\\(.value | tostring)\") | join(\" \")' package.json)",
    "semantic-release": "semantic-release",
    "travis-deploy-once": "travis-deploy-once"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmqb/EvaQueue.js.git"
  },
  "keywords": [],
  "license": "MIT",
  "author": "BMQB Team",
  "bugs": {
    "url": "https://github.com/bmqb/EvaQueue.js/issues"
  },
  "homepage": "https://github.com/bmqb/EvaQueue.js#readme",
  "engines": {
    "node": ">=8.0.0"
  },
  "ava": {
    "files": [
      "test/**/*.ts"
    ],
    "sources": [
      "src/**/*.ts"
    ],
    "failFast": false,
    "tap": false,
    "require": [
      "ts-node/register"
    ],
    "extensions": [
      "ts"
    ],
    "babel": false
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "lib/**/*",
      "src/@types/ali-mns/index.d.ts"
    ],
    "sourceMap": true
  },
  "pre-commit": [
    "lint"
  ],
  "dependencies": {
    "lodash": "^4.17.10"
  },
  "peerDependencies": {
    "ali-mns": "^2.6.5",
    "node-rdkafka": "^2.3.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.109",
    "@types/node": "^10.3.3",
    "ava": "^1.0.0-beta.6",
    "nodemon": "^1.17.5",
    "nyc": "^12.0.2",
    "pre-commit": "^1.2.2",
    "semantic-release": "^15.5.2",
    "travis-deploy-once": "^5.0.0",
    "ts-node": "^6.1.1",
    "tslint": "^5.10.0",
    "tslint-config-airbnb": "^5.9.2",
    "typescript": "^2.9.2"
  }
}
