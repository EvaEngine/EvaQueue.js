{
  "name": "evaqueue",
  "version": "0.0.0-development",
  "description": "EvaQueue.js provide a unified API across different high performance queue backends, including Kafka, AliMNS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./message": {
      "types": "./lib/message.d.ts",
      "default": "./lib/message.js"
    }
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "test": "c8 ava",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmqb/EvaQueue.js.git"
  },
  "keywords": [],
  "license": "MIT",
  "author": "BMQB Team",
  "bugs": {
    "url": "https://github.com/bmqb/EvaQueue.js/issues"
  },
  "homepage": "https://github.com/bmqb/EvaQueue.js#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.8.0",
  "ava": {
    "files": [
      "test/**/*.ts"
    ],
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--import=tsx"
    ],
    "failFast": false,
    "tap": false
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "lib/**/*",
      "src/@types/ali-mns/index.d.ts"
    ],
    "sourceMap": true,
    "reporter": [
      "lcov",
      "text",
      "html"
    ]
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "ali-mns": "^2.6.5",
    "node-rdkafka": "^2.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.14.0",
    "ava": "^6.3.0",
    "c8": "^10.1.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.3",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.28.0"
  }
}
