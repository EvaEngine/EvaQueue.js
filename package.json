{
  "name": "evaqueue",
  "version": "0.0.0-development",
  "description": "EvaQueue.js provide a unified API across different high performance queue backends, including Kafka, AliMNS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./message": {
      "types": "./lib/message.d.ts",
      "default": "./lib/message.js"
    }
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "test": "node --experimental-test-coverage --import tsx/esm --test test/message.ts test/queue.ts test/topic.ts test/nats.ts test/utils/case_converter.ts",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EvaEngine/EvaQueue.js.git"
  },
  "keywords": [],
  "license": "MIT",
  "author": "AlloVince",
  "bugs": {
    "url": "https://github.com/EvaEngine/EvaQueue.js/issues"
  },
  "homepage": "https://github.com/EvaEngine/EvaQueue.js#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@confluentinc/kafka-javascript"
    ]
  },
  "peerDependencies": {
    "@confluentinc/kafka-javascript": "^1.10.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "ali-mns": "^2.6.5"
  },
  "devDependencies": {
    "@confluentinc/kafka-javascript": "^1.10.0",
    "@eslint/js": "^9.22.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.3",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.28.0"
  }
}
