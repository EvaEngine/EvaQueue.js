{
  "name": "evaqueue",
  "version": "0.0.5",
  "description": "Message queue and topic for EvaEngine.js",
  "main": "index.js",
  "scripts": {
    "pretest": "npm run build",
    "prestart": "npm run build",
    "prepublish": "rm -rf ./lib && npm run build",
    "ava": "LOG_LEVEL=error NODE_ENV=test ava --verbose --serial",
    "test": "nyc -a --reporter=lcov --reporter=text --reporter=html npm run ava",
    "lint": "eslint src/* --ext .js",
    "build": "babel -d lib/ src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmqb/EvaQueue.js.git"
  },
  "keywords": [],
  "license": "MIT",
  "author": "BMQB Team",
  "bugs": {
    "url": "https://github.com/bmqb/EvaQueue.js/issues"
  },
  "homepage": "https://github.com/bmqb/EvaQueue.js#readme",
  "engines": {
    "node": ">=6.9.1"
  },
  "ava": {
    "files": [
      "test/**/*.js",
      "!test/bootstrap.js",
      "!test/_*/**/*.js",
      "!test/swagger/_*/**/*.js"
    ],
    "source": [
      "src/**/*.js"
    ],
    "failFast": false,
    "tap": false,
    "require": [
      "babel-core/register",
      "babel-polyfill"
    ],
    "babel": "inherit"
  },
  "nyc": {
    "require": [
      "babel-core/register"
    ],
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "src/config/index.js"
    ]
  },
  "pre-commit": [
    "lint"
  ],
  "dependencies": {
    "ali-mns": "^2.6.4",
    "babel-polyfill": "^6.26.0",
    "kue": "^0.11.6",
    "lodash": "^4.17.4"
  },
  "devDependencies": {
    "ava": "^0.19.1",
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.0",
    "babel-eslint": "^8.0.1",
    "babel-plugin-__coverage__": "^11.0.0",
    "babel-plugin-transform-builtin-extend": "^1.1.2",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "babel-preset-es2015-node6": "^0.4.0",
    "babel-preset-stage-3": "^6.24.1",
    "eslint": "^4.8.0",
    "eslint-config-airbnb": "^16.0.0",
    "eslint-plugin-import": "^2.7.0",
    "eslint-plugin-jsx-a11y": "^6.0.2",
    "eslint-plugin-react": "^7.4.0",
    "nyc": "^11.0.2",
    "pre-commit": "^1.2.2"
  }
}
